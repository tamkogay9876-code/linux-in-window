// Cyberpunk Terminal — main nox customization
terminal {

    background "#050509"

    color "#00ffcc"

    cursor {
        color "#ff00aa"
        blink true
    }

}

prompt {

    style "powerline"

    segment user {
        color "#ff00aa"
        text "user@windows"
    }

    segment cwd {
        color "#00ffcc"
        prefix "~/"
    }

}

animation pulse {

    target "terminal"

    property opacity

    from 0.85

    to 1.0

    duration 1200

    loop true

}
